<UserControl x:Class="NotchPC.App.Remote.PhonePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             xmlns:controls="clr-namespace:NotchPC.App.Controls"
             Foreground="{StaticResource IslandForeground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <controls:InverseBoolToVisibility x:Key="InverseBoolToVis" />
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#26FFFFFF" CornerRadius="10" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,2,4,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- QR code (white background so phone cameras read it on the dark island) -->
        <Border Width="196" Height="196" CornerRadius="16" Background="White" Padding="6" VerticalAlignment="Top"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
            <Image Source="{Binding Qr}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>
        <Border Width="196" Height="196" CornerRadius="16" Background="#14FFFFFF" VerticalAlignment="Top"
                Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="46" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{StaticResource IslandForegroundDim}" />
        </Border>

        <StackPanel Grid.Column="1" Margin="18,2,0,0">
            <TextBlock Text="{loc:Tr Tab.phone}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource IslandForegroundMuted}" />
            <TextBlock Text="{loc:Tr Remote.Scan}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{loc:Tr Remote.OffHint}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource IslandForegroundMuted}"
                       Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVis}}" />
            <TextBlock Text="{Binding DevicesText}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource IslandForegroundMuted}" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource PillButton}" Click="OnTurnOn" Content="{loc:Tr Remote.TurnOn}"
                        Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVis}}" />
                <Button Style="{StaticResource PillButton}" Click="OnNewCode" Content="{loc:Tr Remote.NewCode}" Margin="0,0,8,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource PillButton}" Click="OnTurnOff" Content="{loc:Tr Remote.TurnOff}"
                        Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
