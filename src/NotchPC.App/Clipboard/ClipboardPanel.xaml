<UserControl x:Class="NotchPC.App.Clipboard.ClipboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             xmlns:clip="clr-namespace:NotchPC.App.Clipboard"
             Foreground="{StaticResource IslandForeground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="ClipRow" DataType="{x:Type clip:ClipItemViewModel}">
            <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="6,5" Margin="0,1,2,1" Cursor="Hand"
                    Tag="{Binding}" MouseLeftButtonUp="OnRowClick" ToolTip="{loc:Tr Clip.ClickToCopy}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="34" CornerRadius="8" Background="#1AFFFFFF">
                        <Grid>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource IslandForegroundMuted}" />
                            <Border CornerRadius="8" Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource IslandForegroundMuted}" />
                    </StackPanel>

                    <TextBlock x:Name="PinMark" Grid.Column="2" Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource IslandForegroundMuted}"
                               Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" />
                    <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource NotchSmallIconButton}" Content="&#xE77F;" Tag="{Binding}" Click="OnPaste"
                                ToolTip="{loc:Tr Clip.Paste}" />
                        <Button Style="{StaticResource NotchSmallIconButton}" Content="{Binding PinGlyph}" Tag="{Binding}" Click="OnPin"
                                ToolTip="{Binding PinTip}" />
                        <Button Style="{StaticResource NotchSmallIconButton}" Content="&#xE711;" Tag="{Binding}" Click="OnDelete"
                                ToolTip="{loc:Tr Clip.Delete}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource IslandHover}" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PinMark" Property="Visibility" Value="Collapsed" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource NotchSearchBox}" Tag="{loc:Tr Clip.Search}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnSearchKey" />
            <Button Grid.Column="1" Style="{StaticResource NotchIconButton}" Margin="6,0,0,0" FontSize="13"
                    Content="&#xE74D;" Click="OnClear" ToolTip="{loc:Tr Clip.Clear}" />
        </Grid>

        <Grid>
            <ItemsControl x:Name="List" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ClipRow}" Focusable="False"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Style="{StaticResource NotchScrollViewer}" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="26" HorizontalAlignment="Center"
                           Foreground="{StaticResource IslandForegroundDim}" />
                <TextBlock Text="{Binding EmptyText}" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyHint}" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Center"
                           Foreground="{StaticResource IslandForegroundMuted}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
