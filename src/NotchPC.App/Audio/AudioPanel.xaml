<UserControl x:Class="NotchPC.App.Audio.AudioPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             xmlns:a="clr-namespace:NotchPC.App.Audio"
             xmlns:controls="clr-namespace:NotchPC.App.Controls"
             Foreground="{StaticResource IslandForeground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <controls:InverseBoolToVisibility x:Key="InverseBoolToVis" />
        <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource NotchIconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Output devices -->
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Audio.Output}" FontSize="12.5" FontWeight="SemiBold" Margin="4,0,0,4" />
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Devices}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type a:OutputDeviceRow}">
                    <Button Tag="{Binding}" Click="OnSelectDevice" Focusable="False" Cursor="Hand" Margin="0,1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="8,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Visibility="Hidden" Foreground="{StaticResource IslandForeground}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource IslandForeground}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandHover}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Device volume -->
        <Grid DockPanel.Dock="Top" Height="32" Margin="0,4,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource RowIcon}" Content="{Binding VolumeGlyph}" Click="OnToggleMute" ToolTip="{loc:Tr Quick.Mute}" />
            <Slider Grid.Column="1" Style="{StaticResource NotchSlider}" Margin="6,0,6,0" VerticalAlignment="Center"
                    Value="{Binding Volume}" IsEnabled="{Binding HasOutput}" />
            <TextBlock Grid.Column="2" Text="{Binding VolumeText}" FontSize="11.5" VerticalAlignment="Center" TextAlignment="Right"
                       Foreground="{StaticResource IslandForegroundMuted}" />
        </Grid>

        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource IslandSeparator}" Margin="4,0,4,6" />
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Audio.Apps}" FontSize="12.5" FontWeight="SemiBold" Margin="4,0,0,4" />

        <!-- Per-app mixer -->
        <Grid>
            <ScrollViewer Style="{StaticResource NotchScrollViewer}">
                <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type a:MixerApp}">
                            <Grid x:Name="Row" Height="34" Margin="0,0,4,0" Opacity="0.62">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}" />
                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="6,0,6,0" ToolTip="{Binding Name}" />
                                <Slider Grid.Column="2" Style="{StaticResource NotchSlider}" VerticalAlignment="Center"
                                        Value="{Binding Volume}" />
                                <TextBlock Grid.Column="3" Text="{Binding VolumeText}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"
                                           Foreground="{StaticResource IslandForegroundMuted}" />
                                <Button Grid.Column="4" Style="{StaticResource RowIcon}" Content="{Binding MuteGlyph}" Tag="{Binding}"
                                        Click="OnToggleAppMute" ToolTip="{loc:Tr Quick.Mute}" Margin="4,0,0,0" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{loc:Tr Audio.NoApps}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource IslandForegroundMuted}"
                       Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVis}}" />
        </Grid>
    </DockPanel>
</UserControl>
