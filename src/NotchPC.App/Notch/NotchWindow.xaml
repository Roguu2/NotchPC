<Window x:Class="NotchPC.App.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:notch="clr-namespace:NotchPC.App.Notch"
        xmlns:music="clr-namespace:NotchPC.App.Music"
        xmlns:widgets="clr-namespace:NotchPC.App.Widgets"
        xmlns:clip="clr-namespace:NotchPC.App.Clipboard"
        xmlns:shelf="clr-namespace:NotchPC.App.Shelf"
        xmlns:apps="clr-namespace:NotchPC.App.Apps"
        xmlns:qs="clr-namespace:NotchPC.App.QuickSettings"
        xmlns:notif="clr-namespace:NotchPC.App.Notifications"
        xmlns:remote="clr-namespace:NotchPC.App.Remote"
        xmlns:audio="clr-namespace:NotchPC.App.Audio"
        xmlns:web="clr-namespace:NotchPC.App.Web"
        xmlns:controls="clr-namespace:NotchPC.App.Controls"
        Title="NotchPC"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource IslandForeground}">
    <Window.Resources>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource IslandForegroundMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandHover}" />
                                <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TabTemplate" DataType="{x:Type notch:NotchTab}">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Separator" Width="1" Height="14" Margin="6,0" Background="{StaticResource IslandSeparator}"
                        VerticalAlignment="Center" Visibility="Collapsed" />
                <Button x:Name="Btn" Style="{StaticResource TabButton}" Tag="{Binding}" Click="OnTabClick" ToolTip="{Binding Label}">
                    <Grid>
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Ellipse x:Name="Dot" Width="3" Height="3" Fill="White" Margin="0,0,0,-7"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Hidden" />
                    </Grid>
                </Button>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasSeparatorBefore}" Value="True">
                    <Setter TargetName="Separator" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Btn" Property="Foreground" Value="{StaticResource IslandForeground}" />
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Almost invisible (alpha 1/255) so it still catches the mouse: a slightly larger target than the pill itself. -->
        <Border x:Name="HotZone" Background="#01000000" HorizontalAlignment="Center" VerticalAlignment="Top" />

        <!-- Coloured glow behind the island while a notification banner shows (only its blurred halo is visible). -->
        <Border x:Name="Glow" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0"
                IsHitTestVisible="False" Background="Black"
                Width="{Binding ActualWidth, ElementName=Island}" Height="{Binding ActualHeight, ElementName=Island}"
                Margin="{Binding Margin, ElementName=Island}" CornerRadius="{Binding CornerRadius, ElementName=Island}">
            <Border.Effect>
                <DropShadowEffect x:Name="GlowEffect" ShadowDepth="0" BlurRadius="36" Opacity="1" RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <Border x:Name="Island"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{StaticResource IslandBackground}"
                BorderBrush="{StaticResource IslandBorder}" BorderThickness="1"
                ClipToBounds="True"
                >
            <Grid>
                <!-- Collapsed pill while music plays: cover left, equalizer right (Dynamic Island style). -->
                <Grid x:Name="MiniPlayer" Visibility="Collapsed" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Title · artist; scrolls slowly when it does not fit -->
                    <controls:MarqueeText x:Name="MiniTitle" Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center" />
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="7" HorizontalAlignment="Left" Margin="5,0,0,0" Background="#262629">
                        <Border CornerRadius="7">
                            <Border.Background>
                                <ImageBrush x:Name="MiniCover" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel x:Name="Equalizer" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" RenderTransformOrigin="0.5,0.5" Fill="White">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.55" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" RenderTransformOrigin="0.5,0.5" Fill="White">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.9" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" RenderTransformOrigin="0.5,0.5" Fill="White">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" RenderTransformOrigin="0.5,0.5" Fill="White">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.7" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>

                <!-- Short message in the collapsed pill ("Screenshot saved") -->
                <StackPanel x:Name="FlashLayer" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="FlashGlyph" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="FlashText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- New notification: the pill becomes a banner for a few seconds -->
                <Grid x:Name="BannerLayer" Visibility="Collapsed" Margin="14,0,18,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="11" Background="#1FFFFFFF">
                        <Grid>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Logo}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Header}" FontSize="10.5" Foreground="{StaticResource IslandForegroundMuted}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Body}" FontSize="11.5" Foreground="{StaticResource IslandForegroundMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ExpandedContent" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" Visibility="Collapsed">
                    <DockPanel Margin="16,8,16,14">
                        <ItemsControl x:Name="TabBar" DockPanel.Dock="Top" HorizontalAlignment="Center"
                                      ItemTemplate="{StaticResource TabTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Tab content: real panels + placeholder for tabs of later stages. -->
                        <Grid x:Name="TabContent" Margin="0,10,0,0">
                            <music:MusicPanel x:Name="MusicPanel" Visibility="Collapsed" />
                            <widgets:WidgetsPanel x:Name="WidgetsPanel" Visibility="Collapsed" />
                            <clip:ClipboardPanel x:Name="ClipboardPanel" Visibility="Collapsed" />
                            <shelf:ShelfPanel x:Name="ShelfPanel" Visibility="Collapsed" />
                            <apps:AppsPanel x:Name="AppsPanel" Visibility="Collapsed" />
                            <qs:QuickSettingsPanel x:Name="QuickSettingsPanel" Visibility="Collapsed" />
                            <notif:NotificationsPanel x:Name="NotificationsPanel" Visibility="Collapsed" />
                            <remote:PhonePanel x:Name="PhonePanel" Visibility="Collapsed" />
                            <audio:AudioPanel x:Name="AudioPanel" Visibility="Collapsed" />
                            <web:WebPanel x:Name="WebPanel" Visibility="Collapsed" />
                            <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        DataContext="{Binding SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="30"
                                           HorizontalAlignment="Center" Foreground="{StaticResource IslandForeground}" />
                                <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ComingSoon}" FontSize="12" Margin="0,4,0,0"
                                           HorizontalAlignment="Center" Foreground="{StaticResource IslandForegroundMuted}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
