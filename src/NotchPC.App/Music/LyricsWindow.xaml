<Window x:Class="NotchPC.App.Music.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NotchPC.App.Localization"
        xmlns:music="clr-namespace:NotchPC.App.Music"
        Title="NotchPC lyrics"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource IslandForeground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="LineTemplate" DataType="{x:Type music:LyricLineViewModel}">
            <TextBlock x:Name="Line" Text="{Binding Text}" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold"
                       Margin="0,5" Opacity="0.4" />

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPast}" Value="True">
                    <Setter TargetName="Line" Property="Opacity" Value="0.3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Line" Property="Opacity" Value="1" />
                    <Setter TargetName="Line" Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource IslandForegroundMuted}" />
        </Style>
    </Window.Resources>

    <Border x:Name="Card" CornerRadius="26" Background="{StaticResource IslandBackground}"
            BorderBrush="{StaticResource IslandBorder}" BorderThickness="1">
        <Grid>
            <!-- Accent glow from the album cover -->
            <Border x:Name="Glow" CornerRadius="25" Opacity="0.55" />

            <Grid Margin="18,16,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: drag to move the card, double-click to put it back under the notch -->
                <Grid Grid.Row="0" x:Name="Header" Background="Transparent" Cursor="SizeAll"
                      ToolTip="{loc:Tr Lyrics.DragHint}" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#262629">
                        <Border CornerRadius="10" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ArtistText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource IslandForegroundMuted}" />
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource NotchSmallIconButton}" Content="&#xE8BB;" FontSize="11"
                            VerticalAlignment="Top" ToolTip="{loc:Tr Lyrics.Close}" Click="OnClose" Cursor="Hand" />
                </Grid>

                <!-- Body -->
                <Border Grid.Row="1" x:Name="FadeHost" Margin="0,12,0,0">
                    <!-- Fade top and bottom. The mask sits on this parent of the clipped body (Absolute mapping, height set in code).
                         On the body itself it was measured against the whole translated line list and hid every line
                         once the song was a minute in. -->
                    <Border.OpacityMask>
                        <LinearGradientBrush x:Name="FadeMask" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,200">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="0.12" Color="#FF000000" />
                            <GradientStop Offset="0.85" Color="#FF000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                <Grid x:Name="Body" ClipToBounds="True">
                    <!-- Synced: the list slides so the current line sits in the upper middle.
                         In a Canvas so it keeps its full height: a Grid would layout-clip it to the body height
                         and every line past the first screenful would vanish once scrolled up. -->
                    <Canvas x:Name="LinesCanvas">
                        <ItemsControl x:Name="Lines" ItemsSource="{Binding LyricLines}" ItemTemplate="{StaticResource LineTemplate}"
                                      Focusable="False" Width="{Binding ActualWidth, ElementName=LinesCanvas}">
                            <ItemsControl.RenderTransform>
                                <TranslateTransform x:Name="LinesShift" />
                            </ItemsControl.RenderTransform>
                        </ItemsControl>
                    </Canvas>

                    <!-- Plain (no timing) -->
                    <ScrollViewer x:Name="PlainScroll" VerticalScrollBarVisibility="Hidden" Focusable="False" Visibility="Collapsed">
                        <TextBlock Text="{Binding PlainLyrics}" TextWrapping="Wrap" FontSize="15" LineHeight="24" Margin="0,12" />
                    </ScrollViewer>

                    <!-- Status -->
                    <StackPanel x:Name="Status" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}" />
                        <Button x:Name="RetryButton" Content="{loc:Tr Lyrics.Retry}" Margin="0,12,0,0" HorizontalAlignment="Center"
                                Padding="14,6" Click="OnRetry" Visibility="Collapsed" Focusable="False" />
                    </StackPanel>
                </Grid>
                </Border>

                <TextBlock x:Name="Footer" Grid.Row="2" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"
                           Foreground="{StaticResource IslandForegroundDim}" Text="{loc:Tr Lyrics.Source}" />
            </Grid>
        </Grid>
    </Border>
</Window>
