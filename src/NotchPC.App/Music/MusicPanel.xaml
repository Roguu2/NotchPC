<UserControl x:Class="NotchPC.App.Music.MusicPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             xmlns:controls="clr-namespace:NotchPC.App.Controls"
             Foreground="{StaticResource IslandForeground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- Nothing playing -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMedia}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center"
                       Foreground="{StaticResource IslandForegroundMuted}" />
            <TextBlock Text="{loc:Tr Music.NothingPlaying}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Tr Music.NothingPlaying.Hint}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"
                       Foreground="{StaticResource IslandForegroundMuted}" />
        </StackPanel>

        <!-- Player -->
        <Grid x:Name="Player" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}" Margin="4,2,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cover, title, transport -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="64" Height="64">
                    <Border CornerRadius="14" Background="#262629">
                        <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource IslandForegroundDim}" />
                    </Border>
                    <Border CornerRadius="14" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <!-- Small badge like in the reference -->
                    <Border Width="20" Height="20" CornerRadius="6" Background="#E6E04B6A" BorderBrush="#33000000" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5">
                        <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                    <TextBlock Text="{Binding ArtistText}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource IslandForegroundMuted}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Style="{StaticResource NotchIconButton}" Content="&#xE892;" ToolTip="{loc:Tr Music.Previous}"
                            IsEnabled="{Binding CanGoPrevious}" Click="OnPrevious" />
                    <Button Style="{StaticResource NotchIconButton}" Width="38" Height="38" FontSize="18" Content="{Binding PlayPauseGlyph}"
                            ToolTip="{loc:Tr Music.PlayPause}" IsEnabled="{Binding CanPlayPause}" Click="OnPlayPause" Margin="2,0" />
                    <Button Style="{StaticResource NotchIconButton}" Content="&#xE893;" ToolTip="{loc:Tr Music.Next}"
                            IsEnabled="{Binding CanGoNext}" Click="OnNext" />
                </StackPanel>
            </Grid>

            <!-- Progress (click/drag = seek, wheel = ±5 s) -->
            <controls:MediaProgressBar Grid.Row="1" Margin="0,10,0,0" Height="20"
                                       Progress="{Binding Progress}" CanSeek="{Binding CanSeek}" Duration="{Binding Duration}"
                                       Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}"
                                       SeekRequested="OnSeek" SeekByRequested="OnSeekBy" />

            <!-- Times, mic, lyrics, volume -->
            <Grid Grid.Row="2" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                           VerticalAlignment="Center" Foreground="{StaticResource IslandForegroundMuted}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding MicGlyph}" ToolTip="{Binding MicToolTip}" Click="OnMic">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NotchSmallIconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFF6B6B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MicAvailable}" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#xE7F0;" ToolTip="{loc:Tr Music.ShowLyrics}" Click="OnLyrics" Margin="2,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NotchSmallIconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LyricsOpen}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
                                        <Setter Property="Background" Value="{StaticResource IslandHover}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource NotchSmallIconButton}" Content="{Binding VolumeGlyph}" ToolTip="{loc:Tr Music.MuteOutput}" Click="OnMuteOutput" />
                    <Slider Style="{StaticResource NotchSlider}" Width="110" Margin="4,0,0,0" VerticalAlignment="Center"
                            Value="{Binding Volume, Mode=TwoWay}" ToolTip="{Binding VolumeToolTip}" />
                </StackPanel>

                <TextBlock Grid.Column="4" Text="{Binding RemainingText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                           VerticalAlignment="Center" Foreground="{StaticResource IslandForegroundMuted}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
