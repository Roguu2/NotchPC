<ui:FluentWindow x:Class="NotchPC.App.Web.WebPanelWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:NotchPC.App.Localization"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="NotchPC Web"
                 Width="980" Height="680" MinWidth="480" MinHeight="360"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 Topmost="True"
                 WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar (also the drag area) -->
        <Grid x:Name="Toolbar" Margin="8,0,8,0" MouseLeftButtonDown="OnToolbarMouseDown" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="BackButton" Appearance="Transparent" Padding="8,6" Click="OnBack" ToolTip="{loc:Tr Web.Back}"
                           Icon="{ui:SymbolIcon ArrowLeft24}" />
                <ui:Button x:Name="ForwardButton" Appearance="Transparent" Padding="8,6" Click="OnForward" ToolTip="{loc:Tr Web.Forward}"
                           Icon="{ui:SymbolIcon ArrowRight24}" />
                <ui:Button Appearance="Transparent" Padding="8,6" Click="OnReload" ToolTip="{loc:Tr Web.Reload}"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" />
            </StackPanel>
            <TextBox x:Name="Address" Grid.Column="1" Margin="8,0" Height="30" VerticalAlignment="Center"
                     VerticalContentAlignment="Center" Padding="10,0" KeyDown="OnAddressKeyDown" GotKeyboardFocus="OnAddressFocus" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Transparent" Padding="8,6" Click="OnBookmark" ToolTip="{loc:Tr Web.Bookmark}"
                           Icon="{ui:SymbolIcon Star24}" />
                <ui:Button x:Name="PinButton" Appearance="Transparent" Padding="8,6" Click="OnPin" ToolTip="{loc:Tr Web.Pin}"
                           Icon="{ui:SymbolIcon Pin24}" />
                <ui:Button Appearance="Transparent" Padding="8,6" Click="OnOpenInBrowser" ToolTip="{loc:Tr Web.OpenInBrowser}"
                           Icon="{ui:SymbolIcon Open24}" />
                <ui:Button Appearance="Transparent" Padding="8,6" Click="OnClose" ToolTip="{loc:Tr Web.Close}"
                           Icon="{ui:SymbolIcon Dismiss24}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="6,0,6,6" CornerRadius="8" ClipToBounds="True" Background="#FF1C1C1F">
            <Grid>
                <wv2:WebView2 x:Name="View" DefaultBackgroundColor="#1C1C1F" />
                <TextBlock x:Name="Problem" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="460"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="14" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
