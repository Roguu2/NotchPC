<UserControl x:Class="NotchPC.App.Notifications.NotificationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             xmlns:n="clr-namespace:NotchPC.App.Notifications"
             xmlns:controls="clr-namespace:NotchPC.App.Controls"
             Foreground="{StaticResource IslandForeground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <controls:InverseBoolToVisibility x:Key="InverseBoolToVis" />

        <DataTemplate x:Key="Row" DataType="{x:Type n:NotificationItem}">
            <Border x:Name="Row" Background="Transparent" CornerRadius="12" Padding="8,7" Margin="0,1,2,1"
                    Tag="{Binding}" MouseLeftButtonUp="OnRowClick" ToolTip="{loc:Tr Notify.Open}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="#1AFFFFFF" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasLogo, Converter={StaticResource InverseBoolToVis}}" />
                            <Image Source="{Binding Logo}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0">
                        <TextBlock Text="{Binding Header}" FontSize="10.5" Foreground="{StaticResource IslandForegroundMuted}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Body}" FontSize="11.5" Margin="0,1,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="32" Foreground="{StaticResource IslandForegroundMuted}"
                                   Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Visibility="Hidden">
                        <Button x:Name="InWindows" Style="{StaticResource NotchSmallIconButton}" Content="&#xE91C;" Margin="0,0,2,0"
                                Click="OnOpenInWindows" ToolTip="{loc:Tr Notify.OpenInWindows}"
                                Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}" />
                        <Button x:Name="Close" Style="{StaticResource NotchSmallIconButton}" Content="&#xE711;"
                                Tag="{Binding}" Click="OnDismiss" ToolTip="{loc:Tr Notify.Dismiss}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource IslandHover}" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding CanOpen}" Value="True">
                    <Setter TargetName="Row" Property="Cursor" Value="Hand" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanOpen}" Value="False">
                    <Setter TargetName="Row" Property="ToolTip" Value="{x:Null}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="2,0,0,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr Tab.notifications}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CountText}" FontSize="11.5" Margin="8,1,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource IslandForegroundMuted}" />
            </StackPanel>
            <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" FontSize="13" HorizontalAlignment="Right"
                    Content="&#xE74D;" Click="OnClear" ToolTip="{loc:Tr Notify.ClearAll}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}" />
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="10.5" Margin="4,6,0,0" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource IslandForegroundDim}" />

        <Grid>
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Row}" Focusable="False"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Style="{StaticResource NotchScrollViewer}" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="26" HorizontalAlignment="Center"
                           Foreground="{StaticResource IslandForegroundDim}" />
                <TextBlock Text="{loc:Tr Notify.Empty}" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
