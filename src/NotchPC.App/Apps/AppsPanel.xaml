<UserControl x:Class="NotchPC.App.Apps.AppsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             xmlns:apps="clr-namespace:NotchPC.App.Apps"
             xmlns:controls="clr-namespace:NotchPC.App.Controls"
             Foreground="{StaticResource IslandForeground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <controls:InverseBoolToVisibility x:Key="InverseBoolToVis" />

        <!-- Wide pill button: Screenshot / Snip / Record -->
        <Style x:Key="CaptureButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Background="#17FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#29FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type apps:AppTile}">
            <Grid x:Name="Root">
                <Button Style="{StaticResource TileButton}" Tag="{Binding}" Click="OnLaunch" ToolTip="{Binding ToolTip}">
                    <StackPanel Margin="0,6,0,0">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#1FFFFFFF" HorizontalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}" />
                                <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="2,5,2,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource IslandForegroundMuted}" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveBtn" Style="{StaticResource NotchSmallIconButton}" Width="18" Height="18" FontSize="8"
                        Background="#CC2A2A2E" Foreground="{StaticResource IslandForeground}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" Content="&#xE711;"
                        Tag="{Binding}" Click="OnRemove" ToolTip="{loc:Tr Apps.Remove}" Visibility="Hidden" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type apps:AddTile}">
            <Button Style="{StaticResource TileButton}" Click="OnAdd" ToolTip="{loc:Tr Apps.Add.Hint}">
                <StackPanel Margin="0,6,0,0">
                    <Grid Width="42" Height="42" HorizontalAlignment="Center">
                        <Rectangle RadiusX="12" RadiusY="12" Stroke="#59FFFFFF" StrokeThickness="1.2" StrokeDashArray="3 2.5" />
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource IslandForegroundMuted}" />
                    </Grid>
                    <TextBlock Text="{loc:Tr Apps.Add}" FontSize="11" Margin="2,5,2,0" TextAlignment="Center"
                               Foreground="{StaticResource IslandForegroundMuted}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="-3,0,-3,10">
            <Button Style="{StaticResource CaptureButton}" Click="OnScreenshot" ToolTip="{loc:Tr Apps.Screenshot.Hint}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Tr Apps.Screenshot}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CaptureButton}" Click="OnSnip" ToolTip="{loc:Tr Apps.Snip.Tip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C6;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Tr Apps.Snip}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CaptureButton}" Click="OnRecord" ToolTip="{loc:Tr Apps.Record.Hint}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#FFFF453A" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Tr Apps.Record}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <ScrollViewer Style="{StaticResource NotchScrollViewer}">
            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="70" ItemHeight="74" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
