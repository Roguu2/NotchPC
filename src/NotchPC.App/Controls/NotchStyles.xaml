<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design tokens -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="IslandBackground" Color="#F20B0B0D" />
    <SolidColorBrush x:Key="IslandBorder" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="IslandForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="IslandForegroundMuted" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="IslandForegroundDim" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="IslandHover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="IslandPressed" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="IslandSeparator" Color="#33FFFFFF" />
    <!-- Theme accent (Settings → Appearance): sliders, the selected tab, highlights. -->
    <SolidColorBrush x:Key="NotchAccent" Color="#FFFFFFFF" />

    <!-- Desktop widget card (ref/Widgets.jpg) -->
    <SolidColorBrush x:Key="WidgetBackground" Color="#E6141416" />
    <SolidColorBrush x:Key="WidgetBorder" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="StatsCpuBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="StatsGpuBrush" Color="#FFB07CFF" />
    <SolidColorBrush x:Key="StatsRamBrush" Color="#FFFFA94D" />
    <SolidColorBrush x:Key="CalendarAccentBrush" Color="#FF4C8DFF" />

    <!-- Round icon button used inside the notch and the lyrics card (no focus, no chrome). -->
    <Style x:Key="NotchIconButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="16">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotchSmallIconButton" TargetType="Button" BasedOn="{StaticResource NotchIconButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource IslandForegroundMuted}" />
    </Style>

    <!-- Small round grey button of the timer widget (− / +) -->
    <Style x:Key="WidgetRoundButton" TargetType="Button" BasedOn="{StaticResource NotchIconButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="#2EFFFFFF" />
    </Style>

    <!-- White round play/pause button of the timer widget -->
    <Style x:Key="WidgetPlayButton" TargetType="Button" BasedOn="{StaticResource NotchIconButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="#FFF2F2F2" />
        <Setter Property="Foreground" Value="#FF111111" />
    </Style>

    <!-- Thin scrollbar for lists inside the notch (clipboard, shelf) -->
    <Style x:Key="NotchScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="2" Background="#38FFFFFF" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#66FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotchScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource NotchScrollThumb}" MinHeight="24" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotchScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Margin="4,2,0,2"
                                   Style="{StaticResource NotchScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded search box with an icon and a placeholder (Tag = placeholder text) -->
    <Style x:Key="NotchSearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
        <Setter Property="CaretBrush" Value="{StaticResource IslandForeground}" />
        <Setter Property="SelectionBrush" Value="#668AB4FF" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" CornerRadius="15" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <Grid Margin="11,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource IslandForegroundMuted}" Margin="0,0,8,0" />
                            <TextBlock x:Name="Hint" Grid.Column="1" Text="{TemplateBinding Tag}" VerticalAlignment="Center"
                                       Foreground="{StaticResource IslandForegroundDim}" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#40FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#80FFFFFF" />
                            <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin white slider (volume) -->
    <Style x:Key="NotchSliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Width="11" Height="11" Fill="White" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotchSliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotchSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="18" Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource NotchSliderFill}" Background="{StaticResource NotchAccent}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource NotchSliderFill}" Background="#40FFFFFF" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource NotchSliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
