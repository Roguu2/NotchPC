<UserControl x:Class="NotchPC.App.Widgets.WeatherWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             xmlns:local="clr-namespace:NotchPC.App.Widgets"
             xmlns:controls="clr-namespace:NotchPC.App.Controls"
             Foreground="{StaticResource IslandForeground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Small segmented toggle: Hours | Days -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource IslandForegroundMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="9,2" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Current conditions (the compact widget) -->
        <Grid x:Name="Compact" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TemperatureText}" FontSize="30" FontWeight="SemiBold" Margin="0,-4,0,0" />
            <controls:WeatherIcon Grid.Row="0" Grid.Column="1" Width="26" Height="26" VerticalAlignment="Top"
                                  Kind="{Binding Kind}" IsDay="{Binding IsDay}"
                                  Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource IslandForegroundMuted}" Margin="0,4,8,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,4,0,0">
                <Run Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="9" /><Run Text="{Binding HighText, Mode=OneWay}" />
                <Run Text="  " /><Run Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="9" /><Run Text="{Binding LowText, Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <!-- Forecast (only when the card is big enough) -->
        <StackPanel x:Name="ForecastHeader" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4"
                    Visibility="{Binding ShowForecast, Converter={StaticResource BoolToVis}}">
            <RadioButton Style="{StaticResource Segment}" GroupName="WeatherForecastMode"
                         Content="{loc:Tr Widget.Forecast.Hours}" IsChecked="{Binding IsDaily, Mode=OneWay, Converter={x:Static local:InvertBool.Instance}}"
                         Click="OnHourly" />
            <RadioButton Style="{StaticResource Segment}" GroupName="WeatherForecastMode"
                         Content="{loc:Tr Widget.Forecast.Days}" IsChecked="{Binding IsDaily, Mode=OneWay}" Margin="2,0,0,0"
                         Click="OnDaily" />
        </StackPanel>

        <ItemsControl x:Name="ForecastGrid" Grid.Row="2" ItemsSource="{Binding Forecast}" VerticalAlignment="Top"
                      Visibility="{Binding ShowForecast, Converter={StaticResource BoolToVis}}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ForecastItem}">
                    <StackPanel Height="70" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource IslandForegroundMuted}" />
                        <controls:WeatherIcon Width="20" Height="20" Margin="0,4" Kind="{Binding Kind}" IsDay="{Binding IsDay}" />
                        <TextBlock HorizontalAlignment="Center" FontSize="12">
                            <Run Text="{Binding Temperature, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Secondary, Mode=OneWay}" Foreground="{StaticResource IslandForegroundMuted}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Precipitation}" FontSize="10" HorizontalAlignment="Center" Foreground="#FF8FC1FF" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
