<UserControl x:Class="NotchPC.App.Widgets.GamesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             xmlns:controls="clr-namespace:NotchPC.App.Controls"
             Foreground="{StaticResource IslandForeground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Game tile: cover (or icon) on top, name and play time below -->
        <Style x:Key="GameTile" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round button on a game picture (favourite, hide) -->
        <Style x:Key="TileAction" TargetType="Button" BasedOn="{StaticResource NotchSmallIconButton}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Background" Value="#B3141416" />
            <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,-4,0,6">
            <StackPanel>
                <TextBlock Text="{loc:Tr Tab.games}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding WeekText}" FontSize="11" Foreground="{StaticResource IslandForegroundMuted}" TextTrimming="CharacterEllipsis"
                           Margin="0,0,84,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button FontSize="12" Content="&#xE7B3;" Click="OnShowHidden" ToolTip="{loc:Tr Games.ShowHidden}"
                        Visibility="{Binding HasHidden, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NotchSmallIconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowHidden}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource NotchAccent}" />
                                    <Setter Property="Background" Value="#26FFFFFF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource NotchSmallIconButton}" FontSize="12" Content="&#xE8CB;" Click="OnSort" ToolTip="{Binding SortText}" />
                <Button Style="{StaticResource NotchSmallIconButton}" FontSize="12" Content="&#xE72C;" Click="OnRefresh" ToolTip="{loc:Tr Games.Refresh}" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" CornerRadius="10" Background="#14FFFFFF" Padding="10,6" Margin="0,0,0,6"
                Visibility="{Binding HasLast, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding LastTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding LastDetail}" FontSize="11" Foreground="{StaticResource IslandForegroundMuted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Grid>
            <ScrollViewer Style="{StaticResource NotchScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="List" ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Root">
                            <Button Style="{StaticResource GameTile}" Tag="{Binding}" Click="OnLaunch" ToolTip="{Binding Name}">
                                <StackPanel>
                                    <!-- Picture: the cover, or for games with only an icon a blurred, darkened copy of the
                                         icon as a backdrop with the sharp icon on it (same shape and feel as a cover). -->
                                    <Grid Height="46" controls:RoundClip.Radius="9" Background="#1AFFFFFF">
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" Margin="-14" RenderOptions.BitmapScalingMode="LowQuality"
                                               Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}">
                                            <Image.Effect>
                                                <BlurEffect Radius="18" KernelType="Gaussian" />
                                            </Image.Effect>
                                        </Image>
                                        <Border Background="#73000000" Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}" />
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}">
                                            <Image.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.5" />
                                            </Image.Effect>
                                        </Image>
                                        <Border BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="9" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Margin="1,4,1,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="1,0,1,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource IslandForegroundDim}" />
                                </StackPanel>
                            </Button>

                            <!-- Favourite badge (always), and on hover: star + hide/restore -->
                            <Border x:Name="Badge" Width="18" Height="18" CornerRadius="9" Background="#B3141416" Margin="6,6,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#FFFFD60A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,6,6,0" Visibility="Hidden">
                                <Button x:Name="Star" Style="{StaticResource TileAction}" Content="&#xE734;" Tag="{Binding}" Click="OnFavorite"
                                        ToolTip="{loc:Tr Games.Favorite}" />
                                <Button x:Name="Hide" Style="{StaticResource TileAction}" Content="&#xE711;" Tag="{Binding}" Click="OnHide"
                                        ToolTip="{loc:Tr Games.Hide}" />
                            </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Star" Property="Content" Value="&#xE735;" />
                                    <Setter TargetName="Star" Property="Foreground" Value="#FFFFD60A" />
                                    <Setter TargetName="Star" Property="ToolTip" Value="{loc:Tr Games.Unfavorite}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="Hide" Property="Content" Value="&#xE7A7;" />
                                    <Setter TargetName="Hide" Property="ToolTip" Value="{loc:Tr Games.Restore}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{loc:Tr Games.Empty}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource IslandForegroundDim}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{loc:Tr Games.Loading}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource IslandForegroundDim}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </DockPanel>
</UserControl>
