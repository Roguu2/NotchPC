<UserControl x:Class="NotchPC.App.Widgets.StatsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             xmlns:controls="clr-namespace:NotchPC.App.Controls"
             Foreground="{StaticResource IslandForeground}"
             TextElement.FontFamily="{StaticResource MonoFont}"
             TextElement.FontSize="11.5">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Compact" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="20" />
                <RowDefinition Height="20" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" VerticalAlignment="Center" />
            <controls:MiniBar Grid.Row="0" Grid.Column="1" Value="{Binding CpuLoad}" Fill="{StaticResource StatsCpuBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding CpuTempText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Background="Transparent" ToolTip="{Binding CpuTempHint}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU" VerticalAlignment="Center" />
            <controls:MiniBar Grid.Row="1" Grid.Column="1" Value="{Binding GpuLoad}" Fill="{StaticResource StatsGpuBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding GpuTempText}" HorizontalAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="RAM" VerticalAlignment="Center" />
            <controls:MiniBar Grid.Row="2" Grid.Column="1" Value="{Binding RamLoad}" Fill="{StaticResource StatsRamBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RamText}" HorizontalAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding DownText}" VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding UpText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>

        <!-- Bigger cards: hardware names and a chart of the last minute -->
        <Grid x:Name="Extra" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,4">
            <TextBlock Text="{Binding HardwareText}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource IslandForegroundMuted}" />
            <TextBlock Text="{loc:Tr Widget.Stats.LastMinute}" FontSize="10.5" HorizontalAlignment="Right"
                       Foreground="{StaticResource IslandForegroundDim}" Background="#FF141416" Padding="6,0,0,0" />
        </Grid>
        <controls:SparkChart x:Name="Chart" Grid.Row="2" Visibility="Collapsed" Series="{Binding Series}" Version="{Binding ChartVersion}" />
    </Grid>
</UserControl>
