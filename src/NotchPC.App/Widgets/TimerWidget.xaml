<UserControl x:Class="NotchPC.App.Widgets.TimerWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             xmlns:controls="clr-namespace:NotchPC.App.Controls"
             Foreground="{StaticResource IslandForeground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The dial grows with the card (Viewbox scales ring and time together). -->
            <Viewbox x:Name="Dial" Grid.Column="0" Width="60" Height="60" VerticalAlignment="Center">
                <Grid Width="60" Height="60" Background="Transparent"
                      ToolTip="{loc:Tr Widget.Timer.ResetHint}" MouseLeftButtonDown="OnDialMouseDown">
                    <controls:ProgressRing Progress="{Binding Progress}" Thickness="3" />
                    <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Viewbox>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LengthsText}" FontSize="12" Margin="0,1,0,6" Foreground="{StaticResource IslandForegroundMuted}" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource WidgetPlayButton}" Content="{Binding PlayGlyph}"
                            ToolTip="{loc:Tr Widget.Timer.StartPause}" Click="OnToggle" />
                    <Button Style="{StaticResource WidgetRoundButton}" Content="&#xE738;" Margin="6,0,0,0"
                            ToolTip="{loc:Tr Widget.Timer.Minus}" Click="OnMinus" />
                    <Button Style="{StaticResource WidgetRoundButton}" Content="&#xE710;" Margin="6,0,0,0"
                            ToolTip="{loc:Tr Widget.Timer.Plus}" Click="OnPlus" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Daily summary (only when the card is tall enough) -->
        <Border x:Name="Summary" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,7" CornerRadius="10" Background="#14FFFFFF">
            <StackPanel>
                <TextBlock Text="{Binding TodayText}" FontSize="12" />
                <TextBlock Text="{Binding NextText}" FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource IslandForegroundMuted}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
