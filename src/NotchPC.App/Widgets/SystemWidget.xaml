<UserControl x:Class="NotchPC.App.Widgets.SystemWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NotchPC.App.Controls"
             Foreground="{StaticResource IslandForeground}">
    <StackPanel>
        <Grid>
            <TextBlock Text="{Binding WindowsText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
            <TextBlock Text="{Binding MachineText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                       MaxWidth="70" TextTrimming="CharacterEllipsis" Foreground="{StaticResource IslandForegroundDim}" />
        </Grid>
        <TextBlock Text="{Binding UptimeText}" FontSize="11.5" Margin="0,2,0,10" Foreground="{StaticResource IslandForegroundMuted}" />

        <ItemsControl ItemsSource="{Binding Drives}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,9">
                        <Grid>
                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,90,0" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{StaticResource IslandForegroundMuted}" />
                        </Grid>
                        <controls:MiniBar x:Name="Bar" Value="{Binding Used}" Fill="{StaticResource NotchAccent}" Margin="0,4,0,0" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Warning}" Value="True">
                            <Setter TargetName="Bar" Property="Fill" Value="#FFFF453A" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
