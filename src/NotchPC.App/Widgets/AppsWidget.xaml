<UserControl x:Class="NotchPC.App.Widgets.AppsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             xmlns:apps="clr-namespace:NotchPC.App.Apps"
             xmlns:controls="clr-namespace:NotchPC.App.Controls"
             Foreground="{StaticResource IslandForeground}">
    <UserControl.Resources>
        <controls:InverseBoolToVisibility x:Key="InverseBoolToVis" />

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="70" />
            <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type apps:AppTile}">
            <Grid x:Name="Root">
                <Button Style="{StaticResource TileButton}" Tag="{Binding}" Click="OnLaunch" ToolTip="{Binding ToolTip}">
                    <StackPanel Margin="0,5,0,0">
                        <Border Width="40" Height="40" CornerRadius="11" Background="#1FFFFFFF" HorizontalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}" />
                                <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="2,4,2,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource IslandForegroundMuted}" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveBtn" Style="{StaticResource NotchSmallIconButton}" Width="18" Height="18" FontSize="8"
                        Background="#CC2A2A2E" Foreground="{StaticResource IslandForeground}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,3,0" Content="&#xE711;"
                        Tag="{Binding}" Click="OnRemove" ToolTip="{loc:Tr Apps.Remove}" Visibility="Hidden" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type apps:AddTile}">
            <Button Style="{StaticResource TileButton}" Click="OnAdd" ToolTip="{loc:Tr Apps.Add.Hint}">
                <StackPanel Margin="0,5,0,0">
                    <Grid Width="40" Height="40" HorizontalAlignment="Center">
                        <Rectangle RadiusX="11" RadiusY="11" Stroke="#59FFFFFF" StrokeThickness="1.2" StrokeDashArray="3 2.5" />
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource IslandForegroundMuted}" />
                    </Grid>
                    <TextBlock Text="{loc:Tr Apps.Add}" FontSize="10.5" Margin="2,4,2,0" TextAlignment="Center"
                               Foreground="{StaticResource IslandForegroundMuted}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Widget.Apps.Title}" FontSize="13" FontWeight="SemiBold" Margin="0,-4,0,4" />
        <ScrollViewer Style="{StaticResource NotchScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="List" ItemsSource="{Binding Tiles}" Focusable="False" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="66" ItemHeight="72" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
