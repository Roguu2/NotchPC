<UserControl x:Class="NotchPC.App.Widgets.TwitchWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:NotchPC.App.Widgets"
             xmlns:tw="clr-namespace:NotchPC.Core.Twitch;assembly=NotchPC.Core"
             Foreground="{StaticResource IslandForeground}"
             MinHeight="260">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#66FFFFFF" VerticalAlignment="Center" Margin="0,1,7,0" />
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="Scroll" Grid.Row="1" Style="{StaticResource NotchScrollViewer}" ScrollChanged="OnScrollChanged">
            <ItemsControl ItemsSource="{Binding Messages}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type tw:ChatMessage}">
                        <w:ChatLine Message="{Binding}" FontSize="12" Margin="0,1,6,3" Foreground="{StaticResource IslandForeground}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"
                   Foreground="{StaticResource IslandForegroundMuted}"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
