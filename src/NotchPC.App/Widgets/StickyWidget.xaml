<UserControl x:Class="NotchPC.App.Widgets.StickyWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             Foreground="{StaticResource IslandForeground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,-4,0,6">
            <Button Style="{StaticResource NotchSmallIconButton}" HorizontalAlignment="Left" Click="OnColor"
                    ToolTip="{loc:Tr Widget.Sticky.Color}">
                <Ellipse Width="11" Height="11" Fill="{Binding Dot}" />
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource NotchSmallIconButton}" FontSize="10" Content="&#xE76B;" Click="OnPrev"
                        Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding PageText}" FontSize="11" VerticalAlignment="Center" MinWidth="22" TextAlignment="Center"
                           Foreground="{StaticResource IslandForegroundMuted}"
                           Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource NotchSmallIconButton}" FontSize="10" Content="&#xE76C;" Click="OnNext"
                        Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource NotchSmallIconButton}" FontSize="12" Content="&#xE710;" Click="OnAdd"
                        ToolTip="{loc:Tr Widget.Sticky.Add}" />
                <Button Style="{StaticResource NotchSmallIconButton}" FontSize="12" Content="&#xE74D;" Click="OnDelete"
                        ToolTip="{loc:Tr Widget.Sticky.Delete}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" MinHeight="96">
            <TextBox x:Name="Editor" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="13" Padding="8,6"
                     Background="{Binding Tint}" Foreground="{StaticResource IslandForeground}" CaretBrush="{StaticResource IslandForeground}"
                     SelectionBrush="{StaticResource NotchAccent}" BorderThickness="0">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource NotchScrollViewer}" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
            <TextBlock Text="{loc:Tr Widget.Sticky.Placeholder}" Margin="12,7,0,0" FontSize="13" IsHitTestVisible="False"
                       Foreground="{StaticResource IslandForegroundDim}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
