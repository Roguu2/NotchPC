<UserControl x:Class="NotchPC.App.Widgets.WidgetsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NotchPC.App.Localization"
             Foreground="{StaticResource IslandForeground}">
    <UserControl.Resources>
        <!-- Big toggle tile: icon + label; filled when on -->
        <Style x:Key="WidgetChip" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource IslandForegroundMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="14" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="8,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource IslandForeground}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
        </Style>
        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
        </Style>
    </UserControl.Resources>

    <UniformGrid Columns="6" Margin="0,4,0,0" VerticalAlignment="Center">
        <ToggleButton Style="{StaticResource WidgetChip}" Margin="3,0" IsChecked="{Binding TimerEnabled}">
            <StackPanel>
                <TextBlock Style="{StaticResource ChipGlyph}" Text="&#xE916;" />
                <TextBlock Style="{StaticResource ChipLabel}" Text="{loc:Tr Widget.Chip.Timer}" />
            </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource WidgetChip}" Margin="3,0" IsChecked="{Binding WeatherEnabled}">
            <StackPanel>
                <TextBlock Style="{StaticResource ChipGlyph}" Text="&#xE706;" />
                <TextBlock Style="{StaticResource ChipLabel}" Text="{loc:Tr Settings.Widgets.Weather}" />
            </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource WidgetChip}" Margin="3,0" IsChecked="{Binding CalendarEnabled}">
            <StackPanel>
                <TextBlock Style="{StaticResource ChipGlyph}" Text="&#xE787;" />
                <TextBlock Style="{StaticResource ChipLabel}" Text="{loc:Tr Settings.Widgets.Calendar}" />
            </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource WidgetChip}" Margin="3,0" IsChecked="{Binding StatsEnabled}">
            <StackPanel>
                <TextBlock Style="{StaticResource ChipGlyph}" Text="&#xE9D9;" />
                <TextBlock Style="{StaticResource ChipLabel}" Text="{loc:Tr Widget.Chip.Stats}" />
            </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource WidgetChip}" Margin="3,0" IsChecked="{Binding TwitchEnabled}">
            <StackPanel>
                <TextBlock Style="{StaticResource ChipGlyph}" Text="&#xE8BD;" />
                <TextBlock Style="{StaticResource ChipLabel}" Text="Twitch" />
            </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource WidgetChip}" Margin="3,0" IsChecked="{Binding GridMode}" ToolTip="{loc:Tr Settings.Widgets.Layout.Hint}">
            <StackPanel>
                <TextBlock Style="{StaticResource ChipGlyph}" Text="&#xE8A9;" />
                <TextBlock Style="{StaticResource ChipLabel}" Text="{loc:Tr Widget.Chip.Grid}" />
            </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource WidgetChip}" Margin="3,0" IsChecked="{Binding Locked}" ToolTip="{loc:Tr Settings.Widgets.Locked}">
            <StackPanel>
                <TextBlock Style="{StaticResource ChipGlyph}" Text="&#xE72E;" />
                <TextBlock Style="{StaticResource ChipLabel}" Text="{loc:Tr Widget.Chip.Lock}" />
            </StackPanel>
        </ToggleButton>
    </UniformGrid>
</UserControl>
