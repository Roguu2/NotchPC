<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Installer / uninstaller. Targets .NET Framework 4.7.2, which every Windows 10 (1803+) and 11 has built in,
    so Setup.exe itself needs nothing installed. The app (self-contained, with its own .NET) is embedded as
    payload.zip by scripts\publish.ps1 (-p:Payload=...). Without a payload it builds as an empty shell.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>NotchPC.Setup</RootNamespace>
    <AssemblyName>NotchPC-Setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\NotchPC.App\Assets\NotchPC.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time only: .NET Framework reference assemblies, so the installer builds without a targeting pack (CI). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup Condition="'$(Payload)' != ''">
    <EmbeddedResource Include="$(Payload)" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
